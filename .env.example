# Copy this file to .env (which is gitignored) and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# SQL Server `sa` password. Generate one, e.g.: openssl rand -base64 24
DB_PASSWORD=

# Redis password - backs the auth rate limiter with a shared counter across API instances instead
# of one per process (see Program.cs). Generate one, e.g.: openssl rand -base64 24
REDIS_PASSWORD=

# Symmetric key used to sign access tokens. Generate one, e.g.: openssl rand -base64 32
JWT_SIGNING_KEY=
# Identifies which key signed a given token (the `kid` header) - any short label works.
JWT_SIGNING_KEY_ID=primary

# To rotate the signing key without logging every user out at once: generate a new
# JWT_SIGNING_KEY/JWT_SIGNING_KEY_ID pair, move the *current* values to
# JWT_SIGNING_KEY_PREVIOUS/JWT_SIGNING_KEY_ID_PREVIOUS (and uncomment the matching lines in
# docker-compose.yml), deploy. Old tokens keep validating against the previous key until they
# expire (AccessTokenLifetimeMinutes). After waiting at least that long, remove the *_PREVIOUS
# values and the docker-compose.yml lines, deploy again.
# JWT_SIGNING_KEY_PREVIOUS=
# JWT_SIGNING_KEY_ID_PREVIOUS=

# Optional - SMTP credentials for real password-reset email delivery (any provider that speaks
# SMTP: Gmail with an app password, SendGrid, Resend, Mailgun, Brevo, your own relay, ...). Leave
# SMTP_HOST blank to keep using the logging stub instead - see README.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
